{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Go Tests (Staging)",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/golang_server/staging",
            "args": [
                "-test.v"
            ],
            "showLog": true,
            "trace": "verbose"
        },
        {
            "name": "Debug Current Test File",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}",
            "args": [
                "-test.v"
            ],
            "showLog": true,
            "trace": "verbose"
        },
        {
            "name": "Debug Specific Test Function",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}",
            "args": [
                "-test.v",
                "-test.run",
                "${selectedText}"
            ],
            "showLog": true,
            "trace": "verbose"
        },
        {
            "name": "Debug All Tests with Coverage",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/golang_server/staging",
            "args": [
                "-test.v",
                "-test.coverprofile=coverage.out"
            ],
            "showLog": true,
            "trace": "verbose"
        },
        {
            "name": "Docker: Attach to Consumer Logger",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "remotePath": "/app/main",
            "port": 4000,
            "host": "127.0.0.1",
            "preLaunchTask": "order-consumer-docker-compose-up",
            "postDebugTask": "order-consumer-docker-compose-down",
            "showLog": true,
            "trace": "verbose"
        },
        {
            "name": "Docker: Attach to Order Producer",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "remotePath": "/app/main",
            "port": 8080,
            "host": "localhost",
            "preLaunchTask": "order-producer-docker-compose-up",
            "postDebugTask": "order-producer-docker-compose-down",
            "showLog": true,
            "trace": "verbose"
        }
    ]
}