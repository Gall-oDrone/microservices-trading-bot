# ==============================================================================
# Global Configuration Template - Microservices Trading Bot
# ==============================================================================
# Copy this file to .env and fill in your actual values
# This file should be committed to git as documentation
# ==============================================================================

# ------------------------------------------------------------------------------
# Bitso API Configuration (Production)
# ------------------------------------------------------------------------------
BITSO_API_KEY_NAME=YourApiKeyName
BITSO_API_KEY=your_production_api_key_here
BITSO_API_SECRET=your_production_api_secret_here

# ------------------------------------------------------------------------------
# Bitso API Configuration (Staging/Test)
# ------------------------------------------------------------------------------
STAGE_BITSO_API_KEY_NAME=YourStageApiKeyName
STAGE_BITSO_API_KEY=your_stage_api_key_here
STAGE_BITSO_API_SECRET=your_stage_api_secret_here

# ------------------------------------------------------------------------------
# Redis Configuration (Shared Database)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# For Docker Compose (uncomment when using docker)
# REDIS_HOST=redis

# ------------------------------------------------------------------------------
# Kafka Configuration (Message Broker)
# ------------------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=trading-bot-group

# For Docker Compose (uncomment when using docker)
# KAFKA_BROKERS=kafka:9092

# ------------------------------------------------------------------------------
# Environment & Logging
# ------------------------------------------------------------------------------
ENVIRONMENT=development
# Options: development, staging, production

LOG_LEVEL=info
# Options: debug, info, warn, error

GO111MODULE=off

# ------------------------------------------------------------------------------
# Docker Compose build (fix "compose build requires buildx 0.17.0 or later")
# ------------------------------------------------------------------------------
# When buildx is older than 0.17.0, use the legacy builder so compose build works:
DOCKER_BUILDKIT=0

# ------------------------------------------------------------------------------
# Optional: GitHub Token (for private repos)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=your_github_token_here
