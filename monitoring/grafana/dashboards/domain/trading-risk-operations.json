                "color": "orange",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 18,
      "title": "Tick-to-trade (s)",
      "type": "timeseries",
      "description": "Signal timestamp to exchange ack; the exchange leg alone for comparison.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 27
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (book, le) (rate(signal_to_order_latency_seconds_bucket{job=~\"trading-engine.*\"}[15m])))",
          "legendFormat": "p50 {{book}}",
          "refId": "A"
