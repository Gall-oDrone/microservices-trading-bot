{
  "id": null,
  "uid": "trading-risk-operations",
  "title": "Trading Risk Operations",
  "description": "Kill switch, limits and utilization, pre-trade blocks, execution quality and reconciliation (plan §6.4.4). Alerts: monitoring/prometheus/rules/trading-risk-alerts.yml.",
  "tags": [
    "trading",
    "risk",
    "operations"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 39,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Controls: kill switch, policy, limits",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Kill switch",
      "type": "stat",
      "description": "1 = new orders blocked by an operator halt file (halted, unreadable or invalid).",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "max(trading_halt_active{job=~\"trading-engine.*\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "TRADING"
                },
                "1": {
                  "text": "HALTED"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Invalid halt files",
      "type": "stat",
      "description": "Halt files that cannot be read; each blocks every order (fail closed).",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "max(trading_halt_files_invalid{job=~\"trading-engine.*\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Halt files watched",
      "type": "stat",
      "description": "0 on a live engine = HALT ALL cannot reach it.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "min(trading_halt_files_configured{job=~\"trading-engine.*\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Mode",
      "type": "stat",
      "description": "Dry run logs orders only.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "max(trading_engine_dry_run{job=~\"trading-engine.*\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "LIVE (stage)"
                },
                "1": {
                  "text": "DRY RUN"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "Live risk policy",
      "type": "table",
      "description": "More than one row = replicas enforce different limits.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "max by (version, source) (trading_risk_policy_info{job=~\"trading-engine.*\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Session limit utilization",
      "type": "bargauge",
      "description": "Session loss and drawdown as a fraction of their limits. Orders stop at 100 %.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "max by (limit) (trading_session_limit_utilization_ratio{job=~\"trading-engine.*\"})",
          "legendFormat": "{{limit}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "min": 0,
        "max": 1.2
      }
    },
    {
      "id": 8,
      "title": "Configured limits",
      "type": "table",
      "description": "What the engine enforces (book=session: max daily loss in quote currency, max drawdown %). 0 = disabled.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "expr": "max by (book, limit) (trading_risk_limit{job=~\"trading-engine.*\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Pre-trade: checks, blocks, utilization",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "panels": []
    },
    {
      "id": 10,
      "title": "Policy checks by result",
      "type": "timeseries",
      "description": "allowed / blocked (limit or halt hit) / error (state unknown, fail closed).",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(pretrade_policy_checks_total{job=~\"trading-engine.*\"}[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Blocks by rule (15m)",
      "type": "timeseries",
      "description": "Any rule other than halted is a breach attempt and is reviewed.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "targets": [
        {
          "expr": "sum by (book, rule) (increase(pretrade_policy_rejections_total{job=~\"trading-engine.*\"}[15m]))",
          "legendFormat": "{{book}} {{rule}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "Order limit utilization p50 / p95",
      "type": "timeseries",
      "description": "Order size and notional vs the per-order limit. Warning above 90 % (p95).",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (book, limit, le) (rate(order_limit_utilization_ratio_bucket{job=~\"trading-engine.*\"}[1h])))",
          "legendFormat": "p50 {{book}} {{limit}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (book, limit, le) (rate(order_limit_utilization_ratio_bucket{job=~\"trading-engine.*\"}[1h])))",
          "legendFormat": "p95 {{book}} {{limit}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "Engine order failures by reason",
      "type": "timeseries",
      "description": "risk_policy = shared policy or halt; session_risk = daily loss / drawdown; pretrade_validation = order-management.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(orders_failed_total{job=~\"trading-engine.*\"}[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "title": "OMS risk violations by type",
      "type": "timeseries",
      "description": "shared_policy here means an order reached order-management past the engine gate.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "targets": [
        {
          "expr": "sum by (violation_type) (rate(risk_violations_total{job=~\"order-management.*\"}[5m]))",
          "legendFormat": "{{violation_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 15,
      "type": "row",
      "title": "Execution quality",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "panels": []
    },
    {
      "id": 16,
      "title": "Price vs mid at decision (bps)",
