      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (book, le) (rate(signal_age_at_decision_seconds_bucket{job=~\"trading-engine.*\"}[15m])))",
          "legendFormat": "p50 {{book}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (book, le) (rate(signal_age_at_decision_seconds_bucket{job=~\"trading-engine.*\"}[15m])))",
