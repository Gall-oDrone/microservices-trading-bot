        "h": 7,
        "w": 8,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (book, le) (rate(order_price_deviation_bps_bucket{job=~\"trading-engine.*\"}[30m])))",
          "legendFormat": "p50 {{book}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (book, le) (rate(order_price_deviation_bps_bucket{job=~\"trading-engine.*\"}[30m])))",
          "legendFormat": "p95 {{book}}",
          "refId": "B"
