    {
      "id": 19,
      "title": "Fill ratio (1h)",
      "type": "timeseries",
      "description": "Filled / created orders. Warning below 50 %.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "expr": "sum by (book) (increase(orders_filled_total{job=~\"order-management.*\"}[1h])) / sum by (book) (increase(orders_created_total{job=~\"order-management.*\"}[1h]))",
          "legendFormat": "{{book}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
