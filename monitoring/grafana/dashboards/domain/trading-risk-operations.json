    {
      "id": 21,
      "title": "Intraday P&L and drawdown",
      "type": "timeseries",
      "description": "Order-management intraday P&L against the engine's daily loss limit.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 34
      },
      "targets": [
        {
          "expr": "sum by (currency) (trading_daily_realized_pnl_currency{job=~\"order-management.*\"})",
