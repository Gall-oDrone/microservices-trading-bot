    {
      "id": 19,
      "title": "Fill ratio (1h)",
      "type": "timeseries",
      "description": "Filled / created orders. Warning below 50 %.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "expr": "sum by (book) (increase(orders_filled_total{job=~\"order-management.*\"}[1h])) / sum by (book) (increase(orders_created_total{job=~\"order-management.*\"}[1h]))",
          "legendFormat": "{{book}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 20,
      "title": "OMS reject rate (15m)",
      "type": "timeseries",
      "description": "Rejected / created at order-management. Warning above 20 %.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 34
      },
      "targets": [
        {
          "expr": "sum(rate(orders_rejected_total{job=~\"order-management.*\"}[15m])) / sum(rate(orders_created_total{job=~\"order-management.*\"}[15m]))",
