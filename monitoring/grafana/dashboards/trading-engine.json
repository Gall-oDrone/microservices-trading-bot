{
  "dashboard": {
    "id": null,
    "title": "Trading Engine",
    "tags": ["trading", "trading-engine", "per-service"],
    "timezone": "browser",
    "time": { "from": "now-1h", "to": "now" },
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Scrape status (up)",
        "type": "stat",
        "description": "1 = Prometheus is scraping this service. If 0 or empty, check ServiceMonitor and /metrics.",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
        "targets": [{ "expr": "max(up{job=~\"trading-engine.*\"}) or vector(0)", "refId": "A" }],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
          }
        }
      },
      {
        "id": 2,
        "title": "Orders executed (total)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
        "targets": [{ "expr": "sum(orders_executed_total{job=~\"trading-engine.*\"}) or vector(0)", "refId": "A" }]
      },
      {
        "id": 3,
        "title": "Order execution rate",
        "type": "timeseries",
        "gridPos": { "h": 4, "w": 12, "x": 12, "y": 0 },
        "targets": [{ "expr": "sum(rate(orders_executed_total{job=~\"trading-engine.*\"}[5m])) or vector(0)", "refId": "A", "legendFormat": "orders/s" }]
      },
      {
        "id": 4,
        "title": "Available balance",
        "type": "timeseries",
        "description": "Bitso available balance per currency (from trading-engine).",
        "gridPos": { "h": 6, "w": 12, "x": 0, "y": 4 },
        "targets": [{ "expr": "bitso_available_balance{job=~\"trading-engine.*\"}", "refId": "A", "legendFormat": "{{currency}}" }],
        "fieldConfig": { "defaults": { "unit": "currencyMXN" } }
      },
      {
        "id": 5,
        "title": "Orders executed by book / strategy",
        "type": "timeseries",
        "gridPos": { "h": 6, "w": 12, "x": 12, "y": 4 },
        "targets": [{ "expr": "sum by (book, strategy) (orders_executed_total{job=~\"trading-engine.*\"})", "refId": "A", "legendFormat": "{{book}} {{strategy}}" }]
      }
    ]
  }
}
