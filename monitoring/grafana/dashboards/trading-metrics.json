{
  "dashboard": {
    "id": null,
    "title": "Trading Platform Metrics",
    "tags": ["trading", "bitso"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Trading Engine Health",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"trading-engine\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Order Execution Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(orders_executed_total[5m])",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "API Response Time",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Available Balance",
        "type": "graph",
        "targets": [
          {
            "expr": "bitso_available_balance",
            "refId": "A"
          }
        ]
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "5s"
  }
}
