{
  "id": null,
  "title": "Strategy Executor",
  "tags": [
    "trading",
    "strategies",
    "signals"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Service Health",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "max(up{job=~\"strategy-executor.*\"}) or vector(0)", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Active Strategies",
      "type": "stat",
      "description": "Number of strategies currently running",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "sum(strategy_executor_active_strategies) or vector(0)", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "Signals Generated (rate)",
      "type": "timeseries",
      "description": "Rate of signals generated per strategy",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "targets": [
        { "expr": "sum(rate(strategy_executor_signals_generated_total[5m])) by (strategy, side)", "refId": "A", "legendFormat": "{{strategy}} {{side}}" }
      ]
    },
    {
      "id": 4,
      "title": "Indicator Computation Health",
      "type": "stat",
      "description": "1 = indicators computing normally",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [{ "expr": "strategy_executor_indicators_healthy or vector(0)", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Indicator Last Update Age (s)",
      "type": "stat",
      "description": "Seconds since last indicator update",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [{ "expr": "time() - max(strategy_executor_indicators_last_update_timestamp)", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 120 }
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Strategy Performance",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 }
    },
    {
      "id": 11,
      "title": "Strategy State",
      "type": "table",
      "description": "Current state of each registered strategy",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 5 },
      "targets": [
        { "expr": "strategy_executor_strategy_running", "refId": "A", "legendFormat": "{{strategy}}", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "organize", "options": { "renameByName": { "Value": "Running (1=yes)" } } }
      ]
    },
    {
      "id": 12,
      "title": "Signals by Strategy",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 5 },
      "targets": [
        { "expr": "sum(rate(strategy_executor_signals_generated_total[5m])) by (strategy)", "refId": "A", "legendFormat": "{{strategy}}" }
      ]
    },
    {
      "id": 13,
      "title": "Win Rate by Strategy",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 11 },
      "targets": [
        { "expr": "strategy_executor_strategy_win_rate * 100", "refId": "A", "legendFormat": "{{strategy}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 40 },
              { "color": "green", "value": 50 }
            ]
          }
        }
      }
    },
    {
      "id": 14,
      "title": "Strategy P&L",
      "type": "timeseries",
      "description": "Realized P&L per strategy",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 11 },
      "targets": [
        { "expr": "strategy_executor_strategy_pnl_total", "refId": "A", "legendFormat": "{{strategy}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyMXN" }
      }
    },
    {
      "id": 15,
      "title": "Consecutive Losses",
      "type": "stat",
      "description": "Alert when approaching max consecutive loss limit",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 11 },
      "targets": [
        { "expr": "max(strategy_executor_consecutive_losses) by (strategy)", "refId": "A", "legendFormat": "{{strategy}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Indicators (Real-time)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }
    },
    {
      "id": 21,
      "title": "Bollinger Bands",
      "type": "timeseries",
      "description": "Upper, middle, lower bands with current price",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 18 },
      "targets": [
        { "expr": "strategy_executor_indicator_bollinger_upper{book=\"btc_mxn\"}", "refId": "A", "legendFormat": "Upper" },
        { "expr": "strategy_executor_indicator_bollinger_middle{book=\"btc_mxn\"}", "refId": "B", "legendFormat": "Middle (SMA)" },
        { "expr": "strategy_executor_indicator_bollinger_lower{book=\"btc_mxn\"}", "refId": "C", "legendFormat": "Lower" },
        { "expr": "market_data_last_price{book=\"btc_mxn\"}", "refId": "D", "legendFormat": "Price" }
      ]
    },
    {
      "id": 22,
      "title": "RSI",
      "type": "timeseries",
      "description": "RSI with overbought/oversold levels",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 18 },
      "targets": [
        { "expr": "strategy_executor_indicator_rsi{book=\"btc_mxn\"}", "refId": "A", "legendFormat": "RSI" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "custom": {
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 70 }
            ]
          }
        }
      }
    },
    {
      "id": 23,
      "title": "EMA vs SMA",
      "type": "timeseries",
      "description": "Moving averages for momentum detection",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 18 },
      "targets": [
        { "expr": "strategy_executor_indicator_ema{book=\"btc_mxn\"}", "refId": "A", "legendFormat": "EMA(20)" },
        { "expr": "strategy_executor_indicator_sma{book=\"btc_mxn\"}", "refId": "B", "legendFormat": "SMA(20)" }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "Signal Details",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }
    },
    {
      "id": 31,
      "title": "Signal Totals by Strategy",
      "type": "table",
      "description": "Total signals generated by each strategy",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "targets": [
        { "expr": "strategy_executor_signals_generated_total", "refId": "A", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true }, "renameByName": { "Value": "Total Signals", "strategy": "Strategy", "side": "Side" } } }
      ],
      "fieldConfig": {
        "overrides": [
          { "matcher": { "id": "byName", "options": "Total Signals" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background" } }, { "id": "color", "value": { "mode": "thresholds" } }, { "id": "thresholds", "value": { "steps": [{ "color": "blue", "value": null }] } }] }
        ]
      }
    },
    {
      "id": 32,
      "title": "Signal Rate Over Time",
      "type": "timeseries",
      "description": "Signal generation rate over time by strategy and side",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "targets": [
        { "expr": "increase(strategy_executor_signals_generated_total[1m])", "refId": "A", "legendFormat": "{{strategy}} - {{side}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50
          }
        }
      }
    },
    {
      "id": 40,
      "type": "row",
      "title": "Limit Profit Strategy",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 }
    },
    {
      "id": 41,
      "title": "Circuit Breaker Status",
      "type": "stat",
      "description": "1 = circuit breaker tripped (strategy paused)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 34 },
      "targets": [
        { "expr": "limit_profit_circuit_breaker_active", "refId": "A", "legendFormat": "{{strategy}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "OK", "color": "green" }, "1": { "text": "TRIPPED", "color": "red" } } }
          ]
        }
      }
    },
    {
      "id": 42,
      "title": "Daily Realized P&L (MXN)",
      "type": "timeseries",
      "description": "Session P&L in quote currency (negative = loss)",
      "gridPos": { "h": 6, "w": 8, "x": 4, "y": 34 },
      "targets": [
        { "expr": "limit_profit_daily_realized_pnl_quote", "refId": "A", "legendFormat": "{{strategy}} ({{book}})" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyMXN",
          "custom": {
            "fillOpacity": 20
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0 },
              { "color": "green", "value": 1000 }
            ]
          }
        }
      }
    },
    {
      "id": 43,
      "title": "Entry/Exit Signals",
      "type": "timeseries",
      "description": "Rate of entry and exit signals",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 34 },
      "targets": [
        { "expr": "rate(limit_profit_entry_signals_total[5m])", "refId": "A", "legendFormat": "entry ({{strategy}})" },
        { "expr": "sum(rate(limit_profit_exit_signals_total[5m])) by (strategy)", "refId": "B", "legendFormat": "exit ({{strategy}})" }
      ]
    },
    {
      "id": 44,
      "title": "Exit Reasons Breakdown",
      "type": "piechart",
      "description": "Distribution of exit reasons",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 34 },
      "targets": [
        { "expr": "sum(limit_profit_exit_signals_total) by (reason)", "refId": "A", "legendFormat": "{{reason}}" }
      ]
    },
    {
      "id": 45,
      "title": "Pending Buy Duration (avg)",
      "type": "stat",
      "description": "Average time from entry signal to fill",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 40 },
      "targets": [
        { "expr": "limit_profit_pending_buy_duration_seconds_sum / limit_profit_pending_buy_duration_seconds_count", "refId": "A", "legendFormat": "{{strategy}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          }
        }
      }
    },
    {
      "id": 46,
      "title": "Position Hold Duration (avg)",
      "type": "stat",
      "description": "Average time from fill to exit",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 40 },
      "targets": [
        { "expr": "limit_profit_position_hold_duration_seconds_sum / limit_profit_position_hold_duration_seconds_count", "refId": "A", "legendFormat": "{{strategy}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "red", "value": 600 }
            ]
          }
        }
      }
    },
    {
      "id": 47,
      "title": "Cancel Failures",
      "type": "stat",
      "description": "Failed pending buy cancel attempts (after retries exhausted)",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 40 },
      "targets": [
        { "expr": "limit_profit_pending_cancel_failures_total", "refId": "A", "legendFormat": "{{strategy}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 48,
      "title": "Total Entry Signals",
      "type": "stat",
      "description": "Total BUY signals emitted",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 40 },
      "targets": [
        { "expr": "sum(limit_profit_entry_signals_total) by (strategy)", "refId": "A", "legendFormat": "{{strategy}}" }
      ]
    },
    {
      "id": 49,
      "title": "Total Exit Signals",
      "type": "stat",
      "description": "Total SELL signals emitted",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 40 },
      "targets": [
        { "expr": "sum(limit_profit_exit_signals_total) by (strategy)", "refId": "A", "legendFormat": "{{strategy}}" }
      ]
    },
    {
      "id": 50,
      "title": "Trades Count",
      "type": "stat",
      "description": "Number of completed round-trip trades",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 40 },
      "targets": [
        { "expr": "sum(limit_profit_exit_signals_total) by (strategy)", "refId": "A", "legendFormat": "{{strategy}}" }
      ]
    }
  ]
}
