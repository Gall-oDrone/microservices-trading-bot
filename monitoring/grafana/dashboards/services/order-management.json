{
  "id": null,
  "title": "Order Management",
  "tags": [
    "trading",
    "order-management",
    "per-service"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Scrape status (up)",
      "type": "stat",
      "description": "1 = Prometheus is scraping this service.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "max(up{job=~\".*order-management.*\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Orders created (total)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(orders_created_total{job=~\".*order-management.*\"}) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Orders filled (total)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(orders_filled_total{job=~\".*order-management.*\"}) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active orders",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(orders_active{job=~\".*order-management.*\"}) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "HTTP",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      }
    },
    {
      "id": 6,
      "title": "Request duration (p95)",
      "type": "timeseries",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=~\".*order-management.*\"}[5m])) by (le, path))",
          "refId": "A",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Requests by status",
      "type": "timeseries",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=~\".*order-management.*\"}[5m])) by (status)",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Intraday / P&L (this service)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      }
    },
    {
      "id": 9,
      "title": "Daily Realized P&L",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "expr": "sum(trading_daily_realized_pnl_currency{job=~\".*order-management.*\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyMXN"
        }
      }
    },
    {
      "id": 10,
      "title": "Daily Unrealized P&L",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 11
      },
      "targets": [
        {
          "expr": "sum(trading_daily_unrealized_pnl_currency{job=~\".*order-management.*\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyMXN"
        }
      }
    },
    {
      "id": 11,
      "title": "Drawdown %",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "expr": "max(trading_drawdown_percent{job=~\".*order-management.*\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "id": 12,
      "title": "Trades today",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 11
      },
      "targets": [
        {
          "expr": "sum(trading_trades_today_total{job=~\".*order-management.*\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Kafka consumed (rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(kafka_messages_consumed_total{job=~\".*order-management.*\"}[5m])) by (topic)",
          "refId": "A",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "id": 14,
      "title": "Risk violations",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(risk_violations_total{job=~\".*order-management.*\"}) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "title": "Service uptime (s)",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 16
      },
      "targets": [
        {
          "expr": "max(service_uptime_seconds{job=~\".*order-management.*\"}) or vector(0)",
          "refId": "A"
        }
      ]
    }
  ]
}
