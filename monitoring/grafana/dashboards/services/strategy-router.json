{
  "title": "Strategy Regime Router",
  "tags": ["trading", "strategy-router", "regime"],
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Evaluations / min",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(strategy_router_evaluations_total[5m])) * 60",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Evaluation errors (5m)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(strategy_router_evaluation_errors_total[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "p95 evaluation latency (ms)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(strategy_router_evaluation_latency_ms_bucket[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Blocked (has_position) 30m",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(strategy_router_blocked_total{reason=\"has_position\"}[30m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Regime & active strategy",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 }
    },
    {
      "id": 11,
      "title": "Regime over time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "strategy_router_regime",
          "refId": "A",
          "legendFormat": "{{book}} {{regime}}"
        }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1 } }
    },
    {
      "id": 12,
      "title": "Active strategy",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "strategy_router_active_strategy",
          "refId": "A",
          "legendFormat": "{{book}} {{strategy}}"
        }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1 } }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Switches & blocks",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 }
    },
    {
      "id": 21,
      "title": "Switches / hour",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "sum(rate(strategy_router_switches_total[1h])) by (book, from, to) * 3600",
          "refId": "A",
          "legendFormat": "{{book}} {{from}}→{{to}}"
        }
      ]
    },
    {
      "id": 22,
      "title": "Blocked by reason",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "sum(rate(strategy_router_blocked_total[5m])) by (book, reason)",
          "refId": "A",
          "legendFormat": "{{book}} {{reason}}"
        }
      ]
    },
    {
      "id": 23,
      "title": "Evaluation latency percentiles",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 21 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(strategy_router_evaluation_latency_ms_bucket[5m])) by (le))",
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(strategy_router_evaluation_latency_ms_bucket[5m])) by (le))",
          "refId": "B",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(strategy_router_evaluation_latency_ms_bucket[5m])) by (le))",
          "refId": "C",
          "legendFormat": "p99"
        }
      ]
    }
  ],
  "schemaVersion": 38
}
