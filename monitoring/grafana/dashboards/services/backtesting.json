{
  "dashboard": {
    "id": null,
    "title": "Backtesting",
    "tags": ["trading", "backtesting", "per-service"],
    "timezone": "browser",
    "time": { "from": "now-1h", "to": "now" },
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Scrape status (up)",
        "type": "stat",
        "description": "1 = Prometheus is scraping this service.",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
        "targets": [{ "expr": "max(up{job=~\"backtesting.*\"}) or vector(0)", "refId": "A" }],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
          }
        }
      },
      {
        "id": 2,
        "title": "Backtests created (total)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
        "targets": [{ "expr": "sum(backtesting_backtests_created_total) or vector(0)", "refId": "A" }]
      },
      {
        "id": 3,
        "title": "Active backtests",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
        "targets": [{ "expr": "max(backtesting_active_backtests) or vector(0)", "refId": "A" }]
      },
      {
        "id": 4,
        "title": "Backtests completed (total)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
        "targets": [{ "expr": "sum(backtesting_backtests_completed_total) or vector(0)", "refId": "A" }]
      },
      {
        "id": 5,
        "type": "row",
        "title": "Backtest runs",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 }
      },
      {
        "id": 6,
        "title": "Completed by status",
        "type": "timeseries",
        "gridPos": { "h": 5, "w": 12, "x": 0, "y": 5 },
        "targets": [{ "expr": "sum(backtesting_backtests_completed_total) by (status)", "refId": "A", "legendFormat": "{{status}}" }]
      },
      {
        "id": 7,
        "title": "Failed by reason",
        "type": "timeseries",
        "gridPos": { "h": 5, "w": 12, "x": 12, "y": 5 },
        "targets": [{ "expr": "sum(backtesting_backtests_failed_total) by (reason)", "refId": "A", "legendFormat": "{{reason}}" }]
      },
      {
        "id": 8,
        "title": "Backtest duration (p95, seconds)",
        "type": "timeseries",
        "gridPos": { "h": 5, "w": 12, "x": 0, "y": 10 },
        "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(backtesting_backtest_duration_seconds_bucket[5m])) by (le, status))", "refId": "A", "legendFormat": "{{status}} p95" }]
      },
      {
        "id": 9,
        "title": "Events processed (total by type)",
        "type": "timeseries",
        "gridPos": { "h": 5, "w": 12, "x": 12, "y": 10 },
        "targets": [{ "expr": "sum(backtesting_events_processed_total) by (event_type)", "refId": "A", "legendFormat": "{{event_type}}" }]
      },
      {
        "id": 10,
        "type": "row",
        "title": "Data & errors",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }
      },
      {
        "id": 11,
        "title": "Data load duration (p95, seconds)",
        "type": "timeseries",
        "gridPos": { "h": 5, "w": 12, "x": 0, "y": 16 },
        "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(backtesting_data_load_duration_seconds_bucket[5m])) by (le, source))", "refId": "A", "legendFormat": "{{source}} p95" }]
      },
      {
        "id": 12,
        "title": "Data fetch errors (total by source)",
        "type": "stat",
        "gridPos": { "h": 5, "w": 6, "x": 12, "y": 16 },
        "targets": [{ "expr": "sum(backtesting_data_fetch_errors_total) by (source)", "refId": "A", "legendFormat": "{{source}}" }]
      },
      {
        "id": 13,
        "title": "Data fetch errors (rate)",
        "type": "timeseries",
        "gridPos": { "h": 5, "w": 6, "x": 18, "y": 16 },
        "targets": [{ "expr": "sum(rate(backtesting_data_fetch_errors_total[5m])) by (source)", "refId": "A", "legendFormat": "{{source}}" }]
      },
      {
        "id": 14,
        "title": "Uptime (seconds)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 21 },
        "targets": [{ "expr": "backtesting_uptime_seconds or vector(0)", "refId": "A" }],
        "fieldConfig": { "defaults": { "unit": "s" } }
      },
      {
        "id": 15,
        "title": "Health",
        "type": "stat",
        "description": "1 = healthy, 0 = unhealthy",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 21 },
        "targets": [{ "expr": "max(backtesting_health{component=\"service\"}) or vector(0)", "refId": "A" }],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
          }
        }
      }
    ]
  }
}
