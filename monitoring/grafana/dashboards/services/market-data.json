{"dashboard":{"id":null,"title":"Market Data","tags":["trading","market-data","per-service"],"timezone":"browser","time":{"from":"now-1h","to":"now"},"refresh":"10s","panels":[{"id":1,"title":"Scrape status (up)","type":"stat","description":"1 = Prometheus is scraping this service.","gridPos":{"h":4,"w":6,"x":0,"y":0},"targets":[{"expr":"max(up{job=~\"market-data.*\"}) or vector(0)","refId":"A"}],"fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"thresholds":{"steps":[{"color":"red","value":null},{"color":"green","value":1}]}}}},{"id":2,"title":"WebSocket connections","type":"stat","gridPos":{"h":4,"w":6,"x":6,"y":0},"targets":[{"expr":"market_data_websocket_connections or vector(0)","refId":"A"}]},{"id":3,"title":"Trades (total)","type":"stat","gridPos":{"h":4,"w":6,"x":12,"y":0},"targets":[{"expr":"sum(market_data_trades_total) or vector(0)","refId":"A"}]},{"id":4,"title":"Order book updates (total)","type":"stat","gridPos":{"h":4,"w":6,"x":18,"y":0},"targets":[{"expr":"sum(market_data_orderbook_updates_total) or vector(0)","refId":"A"}]},{"id":5,"type":"row","title":"Streams","gridPos":{"h":1,"w":24,"x":0,"y":4}},{"id":6,"title":"Trade rate","type":"timeseries","gridPos":{"h":5,"w":8,"x":0,"y":5},"targets":[{"expr":"sum(rate(market_data_trades_total[5m])) or vector(0)","refId":"A","legendFormat":"trades/s"}]},{"id":7,"title":"WebSocket messages (rate)","type":"timeseries","gridPos":{"h":5,"w":8,"x":8,"y":5},"targets":[{"expr":"sum(rate(market_data_websocket_messages_total[5m])) or vector(0)","refId":"A","legendFormat":"msg/s"}]},{"id":8,"title":"Order book depth","type":"timeseries","gridPos":{"h":5,"w":8,"x":16,"y":5},"targets":[{"expr":"market_data_orderbook_depth or vector(0)","refId":"A"}]},{"id":9,"title":"Ticker updates (rate)","type":"timeseries","gridPos":{"h":5,"w":12,"x":0,"y":10},"targets":[{"expr":"sum(rate(market_data_ticker_updates_total[5m])) or vector(0)","refId":"A","legendFormat":"ticker/s"}]},{"id":10,"title":"Trade latency (p95)","type"