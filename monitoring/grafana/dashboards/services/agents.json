{
  "id": null,
  "title": "Agents Observability",
  "tags": [
    "agents",
    "ops-agent",
    "agent-coordinator",
    "langchain"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Agent Targets UP",
      "type": "timeseries",
      "description": "Scrape health for agent services. 1 means UP.",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "up{job=~\".*ops-agent.*|.*agent-coordinator.*\"}",
          "refId": "A",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "id": 2,
      "title": "Ops Agent Runs (5m rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum(rate(agent_runs_total[5m]))",
          "refId": "A",
          "legendFormat": "runs/s"
        }
      ]
    },
    {
      "id": 3,
      "title": "Coordinator Runs (5m rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum(rate(coordinator_runs_total[5m]))",
          "refId": "A",
          "legendFormat": "runs/s"
        }
      ]
    },
    {
      "id": 4,
      "title": "Ops Agent Failures (5m rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(agent_failures_total[5m]))",
          "refId": "A",
          "legendFormat": "failures/s"
        }
      ]
    },
    {
      "id": 5,
      "title": "Coordinator Failures (5m rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(coordinator_failures_total[5m]))",
          "refId": "A",
          "legendFormat": "failures/s"
        }
      ]
    },
    {
      "id": 6,
      "title": "Ops Agent p95 Latency (ms)",
      "type": "timeseries",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_run_latency_ms_bucket[5m])) by (le))",
          "refId": "A",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 7,
      "title": "Coordinator p95 Latency (ms)",
      "type": "timeseries",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(coordinator_run_latency_ms_bucket[5m])) by (le))",
          "refId": "A",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 8,
      "title": "Ops Agent Total Runs",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(agent_runs_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Ops Agent Total Failures",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(agent_failures_total)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "title": "Coordinator Total Runs",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(coordinator_runs_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Coordinator Total Failures",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(coordinator_failures_total)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    }
  ]
}
