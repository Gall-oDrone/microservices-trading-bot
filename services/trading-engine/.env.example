# ==============================================================================
# Trading Engine - Service Configuration Template
# ==============================================================================
# Copy this file to .env for local development
# Service-specific configuration (inherits from root .env)
# ==============================================================================

# ------------------------------------------------------------------------------
# Service Identity
# ------------------------------------------------------------------------------
SERVICE_NAME=trading-engine
SERVICE_PORT=8080
PORT=8080

# ------------------------------------------------------------------------------
# Kafka Configuration (Service-Specific)
# ------------------------------------------------------------------------------
# Kafka brokers are inherited from root .env but can be overridden here
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=trading-engine-group

# Kafka topics specific to trading engine
KAFKA_TOPIC_TRADE_SIGNALS=trade-signals
KAFKA_TOPIC_ORDER_EVENTS=order-events

# ------------------------------------------------------------------------------
# Trading Configuration
# ------------------------------------------------------------------------------
# Trading pair (e.g., btc_mxn, eth_mxn)
TRADING_BOOK=btc_mxn

# Trade amount limits (in major currency, e.g., BTC)
MIN_TRADE_AMOUNT=0.001
MAX_TRADE_AMOUNT=0.1

# Maximum trade value (in minor currency, e.g., MXN)
MAX_TRADE_VALUE=10000.0

# Risk management percentages
STOP_LOSS_PERCENT=2.0
TAKE_PROFIT_PERCENT=3.0

# Maximum concurrent open positions
MAX_OPEN_POSITIONS=3

# Trading strategy type
STRATEGY_TYPE=basic

# ------------------------------------------------------------------------------
# Timeouts (in seconds)
# ------------------------------------------------------------------------------
SHUTDOWN_TIMEOUT=30
ORDER_TIMEOUT=10
SIGNAL_TIMEOUT=5
HEALTH_CHECK_INTERVAL=60

# ------------------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------------------
# Enable paper trading (simulate trades without real money)
ENABLE_PAPER_TRADING=false

# Enable Prometheus metrics
ENABLE_METRICS=true

# Enable health check endpoint
ENABLE_HEALTH_CHECK=true

# Enable periodic statistics logging
ENABLE_STATISTICS_LOGGING=true

# ------------------------------------------------------------------------------
# Environment & Logging
# ------------------------------------------------------------------------------
ENVIRONMENT=development
# Options: development, staging, production

ENV=development

LOG_LEVEL=info
# Options: debug, info, warn, error

GO111MODULE=off

# ------------------------------------------------------------------------------
# Notes
# ------------------------------------------------------------------------------
# 1. API credentials are inherited from root .env
# 2. Redis and Kafka brokers can be inherited or overridden
# 3. For Docker: change localhost to service names (redis, kafka)
# 4. Adjust trading limits based on your risk tolerance
# 5. Use ENABLE_PAPER_TRADING=true for testing without real trades
